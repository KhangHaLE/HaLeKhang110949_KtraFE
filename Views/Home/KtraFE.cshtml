@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KtraFE</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="~/Content/Style.css" rel="stylesheet" />
</head>
<body>
    <header>
        <div class="navbar-top">
            <div class="nav-logo">
                <img src="https://static.vecteezy.com/system/resources/thumbnails/019/136/319/small/amazon-logo-amazon-icon-free-free-vector.jpg" alt="Amazon Logo">
                <span class="geo-vietnam">.vn</span>
            </div>

            <div class="nav-delivery">
                <i class="fas fa-map-marker-alt"></i>
                <div>
                    <p>Deliver to</p>
                    <span>Vietnam</span>
                </div>
            </div>

            <div class="nav-search">
                <select class="search-select">
                    <option>All</option>
                </select>
                <input type="text" placeholder="Search Amazon" class="search-input">
                <div class="search-icon">
                    <i class="fas fa-search"></i>
                </div>
            </div>

            <div class="nav-language">
                <i class="fas fa-globe"></i> EN <i class="fas fa-caret-down"></i>
            </div>

            <div class="nav-account">
                <p>Hello, sign in</p>
                <span>Account & Lists <i class="fas fa-caret-down"></i></span>
            </div>

            <div class="nav-orders">
                <p>Returns</p>
                <span>& Orders</span>
            </div>

            <div class="nav-cart">
                <i class="fas fa-shopping-cart"></i>
                <span>Cart</span>
            </div>
        </div>

        <div class="navbar-menu">
            <ul>
                <li><i class="fas fa-bars"></i> All</li>
                <li>Today's Deals</li>
                <li>Customer Service</li>
                <li>Registry</li>
                <li>Gift Cards</li>
                <li>Sell</li>
            </ul>
        </div>
    </header>

    <main class="container">
        <div class="hero-banner">
            <div class="banner-content">
                <h2>Toys for little ones</h2>
                <img src="https://as2.ftcdn.net/v2/jpg/04/06/98/67/1000_F_406986787_gnZJ0V9N82ccz3rh4OeYePkj8tQ9CNNj.jpg"/>
            </div>
        </div>

        <div class="product-grid">
            <div class="card">
                <h3>Get your game on</h3>
                <div class="card-image-large">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTHnHrpdhXvJ4AfWdmRg_mqQVLY2D-IgvZ3T0OfjHDzemmLjn-_iAvoSlbk&s=10" alt="Gaming">
                </div>
                <a href="#">Shop gaming</a>
            </div>

            <div class="card">
                <h3>Shop Fashion for less</h3>
                <div class="card-grid-2x2">
                    <div class="sub-item"><img src="https://img.magnific.com/premium-photo/mom-fit-jeans-isolated_624181-12378.jpg?semt=ais_hybrid&w=740&q=80" alt=""><p>Jeans under $50</p></div>
                    <div class="sub-item"><img src="https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/AB5794s.jpg?im=Resize,width=750" alt=""><p>Tops under $25</p></div>
                    <div class="sub-item"><img src="https://montsand.com/cdn/shop/files/blue-draped-lace-maxi-dress-4751245.jpg?v=1763869981" alt=""><p>Dresses under $30</p></div>
                    <div class="sub-item"><img src="https://file.hstatic.net/200000410665/file/dress-shoes-la-gi-cac-loai-dress-shoes_33d05c8cf04a4ff3b0c07a2d3d6eb0f3.jpg" alt=""><p>Shoes under $50</p></div>
                </div>
                <a href="#">Shop fashion</a>
            </div>

            <div class="card">
                <h3>Shop for your home essentials</h3>
                <div class="card-grid-2x2">
                    <div class="sub-item"><img src="https://cdn.apartmenttherapy.info/image/upload/f_jpg,q_auto:eco,c_fill,g_auto,w_1500,ar_4:3/at%2Fhouse%20tours%20stock%20archive%2F5a8f38b5fef577fbfc2d9e46096d3071406fda1e" alt=""><p>Cleaning Tools</p></div>
                    <div class="sub-item"><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT9bYNAKejnSRIIrEPDizJnf42lX8mxbvFqOK-ArgLiaI12TKsL7kntW5Rv&s=10" alt=""><p>Home Storage</p></div>
                    <div class="sub-item"><img src="https://www.maihomedecor.com/wp-content/uploads/2024/06/Screenshot-2024-06-08-at-18.28.05.png" alt=""><p>Home Decor</p></div>
                    <div class="sub-item"><img src="https://minhhabedding.vn/cdn/shop/files/ChatGPT_Image_Jul_28_2026_03_10_31_PM.png?v=1785226372&width=1445" alt=""><p>Bedding</p></div>
                </div>
                <a href="#">Discover more</a>
            </div>

            <div class="card">
                <h3>Refresh your space</h3>
                <div class="card-grid-2x2">
                    <div class="sub-item"><img src="https://file.hstatic.net/200000416255/collection/z3383893570883_c6f6bd7388836c7053482ef7e9fbc47c_b5098dae8a84463094fd7904c2badeb7.jpg" alt=""><p>Dining</p></div>
                    <div class="sub-item"><img src="https://lovechicliving.co.uk/wp-content/uploads/2023/11/household-list-of-items.jpg" alt=""><p>Home</p></div>
                    <div class="sub-item"><img src="https://cwservicesinc.com/wp-content/uploads/Must-Have-Small-Kitchen-Appliances.jpg" alt=""><p>Kitchen</p></div>
                    <div class="sub-item"><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQe6-9Dl0RVWIKkSbXKwCt7tzrIZmUKlPWKye4rcui8CxW3PjW5cnlc1MJ_&s=10" alt=""><p>Health and Beauty</p></div>
                </div>
                <a href="#">See more</a>
            </div>
        </div>

        <div class="related-products">
            <h3>Related to items you've viewed</h3>
            <div class="product-row">
                <img src="https://cdn.hstatic.net/products/200000690725/55331661973_ff9de4ff26_c_975a8dae49754c44aee68aa0c53c8798_master.jpg" alt="T-Shirt">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQDkrBHrJa0iq9CR-dvegfTiOZ3dsgtZA43thjJ_MRbIg&s=10" alt="Toys">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTqU_nBN54H-NkzIx8pj-gS1jbw24GkNjZhd253O4VrkA&s=10" alt="Books">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR_iL9Nodjs59oHcNxD4Z4AR5xXIfsMVxXMX_HSdTdDLxs1_5ZXF_OM-ms&s=10" alt="Chairs">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSWuYWVhY6jmELqhqY5oH69FwtbTYhTatE5stF0b7Zoh2sKnOZ4zipNqRPK&s=10" alt="Cat food">
                <img src="https://cdn.britannica.com/94/151894-050-F72A5317/Brown-eggs.jpg" alt="Eggs">
                <img src="https://i5.walmartimages.com/seo/Htcenly-Running-Shoes-Men-Fashion-Sneakers-Casual-Walking-Shoes-Sport-Athletic-Shoes-Lightweight-Breathable-Comfortable_4114141f-7d26-4dd7-933d-babc24080395.516ad145e1a1d8d82a801ac48231950d.jpeg" alt="Shoes">
            </div>
        </div>
    </main>

    <footer>
        <div class="back-to-top">
            Back to top
        </div>
        <div class="footer-links">
            <div class="footer-column">
                <h4>Get to Know Us</h4>
                <ul>
                    <li>Careers</li>
                    <li>Blog</li>
                    <li>About Amazon</li>
                </ul>
            </div>
            <div class="footer-column">
                <h4>Make Money with Us</h4>
                <ul>
                    <li>Sell products on Amazon</li>
                    <li>Sell on Amazon Business</li>
                    <li>Become an Affiliate</li>
                    <li>Make some Friends</li>
                </ul>
            </div>
            <div class="footer-column">
                <h4>Amazon Payment Products</h4>
                <ul>
                    <li>Amazon Business Card</li>
                    <li>Shop with Points</li>
                    <li>Reload Your Balance</li>
                </ul>
            </div>
            <div class="footer-column">
                <h4>Let Us Help You</h4>
                <ul>
                    <li>Amazon and COVID-19</li>
                    <li>Your Account</li>
                    <li>Your Orders</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>Conditions of Use &nbsp;&nbsp;&nbsp; Privacy Notice &nbsp;&nbsp;&nbsp; Consumer Health Data Privacy Disclosure</p>
            <p>© 1996-2026, Amazon.com, Inc. or its affiliates</p>
        </div>
    </footer>
    <div>hello :)</div>
    <img src="https://email-files.fangamer.com/list_48/campaign_18/cat_batting-cyOHKzSGkQUTJpvN.gif" alt="Alternate Text" />
</body>
</html>

